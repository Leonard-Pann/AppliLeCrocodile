<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:AppliLeCrocodile.Behaviors"
             xmlns:vm="using:AppliLeCrocodile.ViewModels"
             x:Class="AppliLeCrocodile.Views.MainView"
             x:DataType="vm:MainViewModel" TopLevel.AutoSafeAreaPadding="True"
             Background="White" ClipToBounds="True">
    <Grid Background="White"
          behaviors:HorizontalSwipeBehavior.NextCommand="{Binding GoToNextPageCommand}"
          behaviors:HorizontalSwipeBehavior.PreviousCommand="{Binding GoToPreviousPageCommand}"
          behaviors:HorizontalSwipeBehavior.Threshold="48"
          behaviors:HorizontalSwipeBehavior.IsEnabled="{Binding IsHorizontalSwipeEnabled}"
          behaviors:DismissFocusOnBackgroundBehavior.IsEnabled="True">
        <Carousel ItemsSource="{Binding Pages}" SelectedIndex="{Binding CurrentPageIndex, Mode=TwoWay}"
                  IsSwipeEnabled="False" IsVisible="{Binding IsMenuReady}" Background="White">
            <Carousel.PageTransition>
                <PageSlide Duration="0:0:0.25" Orientation="Horizontal" />
            </Carousel.PageTransition>
        </Carousel>
        <Grid IsVisible="{Binding IsLoading}" Background="White">
            <ProgressBar Width="160" Height="5" IsIndeterminate="True"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Border IsVisible="{Binding HasError}" Padding="32" Background="White">
            <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="15" LineHeight="20"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <Button Command="{Binding InitializeCommand}" Content="{Binding RetryText}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
