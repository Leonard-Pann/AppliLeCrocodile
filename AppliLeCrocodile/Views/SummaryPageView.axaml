<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AppliLeCrocodile.ViewModels"
             x:Class="AppliLeCrocodile.Views.SummaryPageView"
             x:DataType="vm:SummaryPageViewModel"
             Background="White">
    <Viewbox Stretch="Uniform">
        <Border Width="{Binding ReferenceWidth}"
                Height="{Binding ReferenceHeight}"
                Padding="20,40,20,34"
                Background="White"
                AutomationProperties.Name="{Binding AccessibilityName}">
            <StackPanel Spacing="0">
                <TextBlock Text="{Binding BarName}"
                           FontSize="50"
                           FontWeight="Bold"
                           TextAlignment="Center" />
                <TextBlock Margin="0,5,0,0"
                           Text="{Binding BarDescription}"
                           FontSize="12"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel Margin="0,25"
                            Spacing="7">
                    <TextBlock Text="{Binding OpeningDays}"
                               FontSize="23"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding OpeningHours}"
                               FontSize="23"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding ClosedDays}"
                               FontSize="23"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                </StackPanel>

                <TextBlock HorizontalAlignment="Center"
                           Text="{Binding HappyHourTitle}"
                           FontSize="18"
                           FontWeight="Bold"
                           TextDecorations="Underline" />

                <StackPanel Margin="0,25,0,20"
                            Spacing="4">
                    <TextBlock Text="{Binding HappyHourDays}" FontSize="18" TextAlignment="Center" />
                    <TextBlock Text="{Binding HappyHourHours}" FontSize="18" TextAlignment="Center" />
                    <TextBlock Text="{Binding HappyHourCocktailPrice}"
                               FontSize="18"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding WeekCocktailPrice}" FontSize="18" TextAlignment="Center" />
                    <TextBlock Text="{Binding And}" FontSize="18" TextAlignment="Center" />
                    <TextBlock Text="{Binding Weekend}" FontSize="18" TextAlignment="Center" />
                    <TextBlock Text="{Binding WeekendHappyHourHours}" FontSize="18" TextAlignment="Center" />
                    <TextBlock Text="{Binding WeekendHappyHourPrice}"
                               FontSize="18"
                               FontWeight="Bold"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding WeekendPrice}" FontSize="18" TextAlignment="Center" />
                </StackPanel>

                <TextBlock Margin="0,5,0,0"
                           Text="{Binding Facebook}"
                           FontSize="15"
                           FontWeight="Bold"
                           TextAlignment="Center" />
                <TextBlock Margin="0,20,0,0"
                           Text="{Binding Address}"
                           FontSize="12"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Viewbox>
</UserControl>
